{
  "extends": "klarity/tsconfig/library",
  "compilerOptions": {
    "customConditions": ["workspace-source"],
    "lib": ["ES2024"],
    "types": ["node"],
    "rootDir": ".",
    "erasableSyntaxOnly": true,
    "noErrorTruncation": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": {
          "experimentalApiUsage": "off",
          "unstableApiUsage": "off"
        },
        "keyPatterns": [{ "target": "service", "pattern": "package-identifier" }],
        "allowedUnstableApis": [
          "@ensforge/sdk/internal/rpc",
          "@ensforge/sdk/internal/write/simulate",
          "@effect/platform-node",
          "effect/ByteSize",
          "effect/FileSystem",
          "effect/Path",
          "effect/ai",
          "effect/cli",
          "effect/http",
          "effect/persistence"
        ]
      }
    ]
  },
  "include": ["src/**/*.ts"]
}
